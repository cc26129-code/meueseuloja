# Supabase (chaves públicas também são usadas no navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=CONFIGURE_APENAS_NO_SERVIDOR
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Mercado Pago (apenas servidor)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=...
PUBLIC_SITE_URL=https://seu-dominio.com.br

# Melhor Envio (somente servidor)
# Use "sandbox" durante os testes e "production" apenas após homologar.
MELHOR_ENVIO_ENVIRONMENT=sandbox
STORE_ORIGIN_POSTAL_CODE=00000000
MELHOR_ENVIO_USER_AGENT=meueseuloja (contato@seu-dominio.com.br)
MELHOR_ENVIO_ACCESS_TOKEN=TOKEN_OAUTH_DO_AMBIENTE
MELHOR_ENVIO_REFRESH_TOKEN=REFRESH_TOKEN_DO_AMBIENTE
MELHOR_ENVIO_TOKEN_EXPIRES_AT=2026-09-12T12:00:00.000Z
MELHOR_ENVIO_CLIENT_ID=CLIENT_ID_DO_APLICATIVO
MELHOR_ENVIO_CLIENT_SECRET=CLIENT_SECRET_DO_APLICATIVO
MELHOR_ENVIO_REDIRECT_URI=https://seu-dominio.com.br/integracoes/melhor-envio/callback

# Notificações por e-mail opcionais (apenas servidor)
RESEND_API_KEY=re_...
ADMIN_NOTIFICATION_EMAIL=pedidos@seu-dominio.com.br
ADMIN_NOTIFICATION_FROM=Loja <noreply@seu-dominio.com.br>
