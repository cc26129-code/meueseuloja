{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ymueqnizqanvaolhvfvk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meueseuloja",
      "version": "0.1.0",
      "title": "meueseuloja"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "Listar produtos",
        "description": "Lista os produtos da loja com preço, descrição e quantidade em estoque. Permite filtrar por status de estoque.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stock_filter": {
              "type": "string",
              "enum": [
                "all",
                "in_stock",
                "low_stock",
                "out_of_stock"
              ],
              "default": "all",
              "description": "Filtro de estoque: todos, disponíveis, estoque baixo (1 a 5) ou esgotados."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Máximo de produtos retornados."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_stock",
        "title": "Atualizar estoque",
        "description": "Define a quantidade em estoque de um produto. Requer conta de administrador da loja.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID do produto."
            },
            "stock_quantity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "description": "Nova quantidade em estoque."
            }
          },
          "required": [
            "product_id",
            "stock_quantity"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_orders",
        "title": "Listar pedidos",
        "description": "Lista os pedidos PIX da loja com cliente, itens, total e status do pagamento. Requer conta de administrador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "pending",
                "paid",
                "failed",
                "expired",
                "cancelled"
              ],
              "default": "all",
              "description": "Filtro por status do pagamento."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Máximo de pedidos retornados."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "store_summary",
        "title": "Resumo da loja",
        "description": "Resumo com total de produtos, produtos esgotados ou com estoque baixo, pedidos pagos e faturamento confirmado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
